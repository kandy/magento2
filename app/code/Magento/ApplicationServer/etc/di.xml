<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Magento\Framework\GraphQl\ConfigInterface" type="Magento\ApplicationServer\GraphQl\Config"/>
    <type name="Magento\ApplicationServer\GraphQl\Config">
        <arguments>
            <argument name="data" xsi:type="object">Magento\Framework\GraphQl\Config\Data</argument>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="serverStartCommand" xsi:type="object">Magento\ApplicationServer\Console\ServerStartCommand</item>
            </argument>
        </arguments>
    </type>

    <preference for="Magento\Framework\Stdlib\CookieManagerInterface" type="Magento\ApplicationServer\App\CookieManager" />
    <preference for="Magento\Framework\Stdlib\Cookie\CookieReaderInterface" type="Magento\ApplicationServer\App\CookieManager" />

    <type name="Magento\ApplicationServer\App\CookieManager">
        <arguments>
            <argument name="request" xsi:type="object">Magento\Framework\App\Request\Http\Proxy</argument>
        </arguments>
    </type>

    <type name="Magento\Framework\App\Request\Http">
        <arguments>
            <argument name="cookieReader" xsi:type="object">Magento\ApplicationServer\App\CookieManager\Proxy</argument>
        </arguments>
    </type>
</config>
